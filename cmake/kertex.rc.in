#define VS_FFI_FILEFLAGSMASK 0x0000003fL
#define VS_FF_PRERELEASE 0x00000002L
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
#define VFT2_UNKNOWN 0x00000000L

1 VERSIONINFO
 FILEVERSION @KERTEX_FILE_VERSION@
 PRODUCTVERSION @KERTEX_FILE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @KERTEX_FILE_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "The kerTeX contributors\0"
            VALUE "FileDescription", "kerTeX @KERTEX_RESOURCE_NAME@ utility\0"
            VALUE "FileVersion", "@KERTEX_PACKAGE_VERSION@\0"
            VALUE "InternalName", "@KERTEX_RESOURCE_NAME@\0"
            VALUE "LegalCopyright", "KerTeX public licence 1.0 and component licences\0"
            VALUE "OriginalFilename", "@KERTEX_RESOURCE_NAME@.exe\0"
            VALUE "ProductName", "kerTeX for Windows\0"
            VALUE "ProductVersion", "@KERTEX_PACKAGE_VERSION@\0"
            VALUE "SourceVersion", "@KERTEX_SOURCE_VERSION@\0"
            VALUE "SourceRevision", "@KERTEX_SOURCE_REVISION@\0"
            VALUE "Repository", "https://github.com/Thewafflication/kertex_package\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

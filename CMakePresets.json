{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/wpm-tinycc-wcrt.cmake"
    },
    { "name": "x86-release", "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "KERTEX_ARCH": "x86" } },
    { "name": "x64-release", "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "KERTEX_ARCH": "x64" } },
    { "name": "arm64-release", "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "KERTEX_ARCH": "arm64" } }
  ],
  "buildPresets": [
    { "name": "build-x86-release", "configurePreset": "x86-release" },
    { "name": "build-x64-release", "configurePreset": "x64-release" },
    { "name": "build-arm64-release", "configurePreset": "arm64-release" }
  ]
}
